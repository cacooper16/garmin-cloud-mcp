// Copy this file to wrangler.jsonc (which is git-ignored) and fill in the two
// values marked FILL IN, or run `npm run setup`, which does it for you. See the
// README's setup steps.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "garmin-cloud-mcp",
	"main": "src/index.ts",
	// Serve the Worker at https://<name>.<subdomain>.workers.dev (its sign-in URL).
	"workers_dev": true,
	// No extra public preview URL per uploaded version: only the one URL above.
	"preview_urls": false,
	"compatibility_date": "2026-11-01",
	// global_fetch_strictly_public: the Worker can't fetch private/internal
	// addresses (SSRF hardening) and it enables Client ID Metadata Documents,
	// the newer way MCP clients register.
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public",
	],
	"vars": {
		// Optional. The public URL your MCP client connects to, which every OAuth
		// token is bound to. Normally worked out from each request
		// (https://<host>/mcp), so leave it unset. Set it only to pin a single URL,
		// e.g. when the Worker also answers on a custom domain:
		// "MCP_RESOURCE": "https://garmin.example.com/mcp",
		// Optional. Turns off the daily update check (a download of a small
		// version file from GitHub; see the README's Security model):
		// "GARMIN_MCP_NO_UPDATE_CHECK": "1",
		// FILL IN: your numeric GitHub user ID (not your username: usernames can be
		// renamed and re-registered). Find it at https://api.github.com/users/<username>
		// "0" lets nobody in.
		"ALLOWED_GITHUB_USER_ID": "0",
	},
	"kv_namespaces": [
		{
			// Holds OAuth grants/tokens, the cached Garmin bearer token and
			// cached past-date responses.
			"binding": "OAUTH_KV",
			// FILL IN: the id printed by `npx wrangler kv namespace create garmin-cloud-mcp-OAUTH_KV`
			// (titled after the Worker; the binding name stays OAUTH_KV)
			"id": "YOUR_KV_NAMESPACE_ID",
		},
	],
	"observability": {
		"enabled": true,
	},
	"dev": {
		"port": 8788,
	},
	"secrets": {
		"required": [
			"GITHUB_CLIENT_ID",
			"GITHUB_CLIENT_SECRET",
			"COOKIE_ENCRYPTION_KEY",
			"GARMIN_API_KEY",
		],
	},
}
