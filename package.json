{
	"name": "garmin-mcp",
	"version": "1.4.0",
	"mcpName": "io.github.colincooperio/garmin-mcp",
	"description": "Ask Claude, ChatGPT or any AI assistant about your Garmin training, sleep and recovery. Uses Garmin's official Personal API: no password, read-only. Run locally with npx or self-host on Cloudflare.",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/colincooperio/garmin-mcp.git"
	},
	"homepage": "https://github.com/colincooperio/garmin-mcp#readme",
	"bugs": {
		"url": "https://github.com/colincooperio/garmin-mcp/issues"
	},
	"bin": {
		"garmin-mcp": "dist/stdio.js"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"keywords": [
		"mcp",
		"model-context-protocol",
		"mcp-server",
		"claude",
		"chatgpt",
		"garmin",
		"garmin-connect",
		"cloudflare-workers",
		"fitness",
		"health",
		"personal-api",
		"npx"
	],
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "wrangler dev",
		"build": "npm run types && tsc -p tsconfig.build.json",
		"sync:prompts": "node --experimental-strip-types --no-warnings scripts/sync-manifest-prompts.mjs",
		"build:mcpb": "npm run sync:prompts && esbuild src/stdio.ts --bundle --platform=node --format=esm --target=node20 --outfile=mcpb/server/index.js --log-level=warning && mcpb pack mcpb garmin-mcp.mcpb",
		"check": "npm run types && tsc --noEmit && mcpb validate mcpb/manifest.json && npm test && npm run test:e2e",
		"setup": "node scripts/setup.mjs",
		"update": "node scripts/update.mjs",
		"deploy": "npm run check && wrangler deploy",
		"tail": "wrangler tail",
		"stdio": "node --experimental-strip-types --no-warnings src/stdio.ts",
		"types": "wrangler types --config wrangler.example.jsonc",
		"type-check": "npm run types && tsc --noEmit",
		"test": "node --experimental-strip-types --test test/*.test.ts",
		"test:pack": "node --experimental-strip-types --no-warnings --test test/pack.test.ts",
		"test:e2e": "wrangler deploy --dry-run --config wrangler.example.jsonc --outdir .wrangler/e2e-dist && node --experimental-strip-types --no-warnings test/e2e.mjs",
		"prepublishOnly": "npm run check && npm run build"
	},
	"dependencies": {
		"@modelcontextprotocol/server": "2.3.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@anthropic-ai/mcpb": "^2.1.2",
		"@cloudflare/workers-oauth-provider": "^1.2.4",
		"@types/node": "^24.0.0",
		"agents": "^0.29.0",
		"esbuild": "^0.28.2",
		"hono": "^4.12.27",
		"miniflare": "^4.20260730.0",
		"typescript": "6.0.3",
		"wrangler": "^4.105.0"
	}
}
